# Existing API proxy configuration. NEXT_PUBLIC_API_URL is compiled into the browser build.
BACKEND_API_URL=https://api-planyourwedding.bulmar.tech
NEXT_PUBLIC_API_URL=/backend-api

# Optional error monitoring. Empty DSNs mean no SDK initialization or event delivery.
# DSN is a project ingestion address from Sentry, not the website's DNS or deployment URL.
NEXT_PUBLIC_SENTRY_DSN=
# Optional Next.js Node server error reporting; use a server-side DSN explicitly.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=

# Optional private source-map uploads from a trusted deployment build only.
# Keep the auth token secret; never prefix it with NEXT_PUBLIC_.
SENTRY_UPLOAD_SOURCEMAPS=false
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
