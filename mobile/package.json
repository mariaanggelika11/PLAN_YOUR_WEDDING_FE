{
  "name": "plan-your-wedding-android",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "i18next": "^27.1.1",
    "lucide-react-native": "^1.72.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.ts",
    "bundle:android": "expo export --platform android --output-dir dist-android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "build:apk": "node scripts/build-apk.mjs",
    "test:native": "jest --runInBand",
    "sync:planning": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-planning.mjs",
    "prestart": "npm run sync:planning",
    "prebundle:android": "npm run sync:planning",
    "prebuild:apk": "npm run sync:planning",
    "lint": "eslint src --max-warnings=0",
    "check": "npm run sync:planning && npm run lint && npm run typecheck && npm test && npm run test:native && npm run bundle:android"
  },
  "private": true,
  "overrides": {
    "minimatch@>=7 <11": "^11.0.1",
    "glob@>=9 <15": "^14.0.2"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  }
}
